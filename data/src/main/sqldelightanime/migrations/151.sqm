-- Reels watch history (host-side, contract-independent): the last-watched position per
-- (video_id, source_id) feeding the "Recent" surface and the resume-seek of re-watched clips.
CREATE TABLE IF NOT EXISTS reels_watch_history(
    video_id TEXT NOT NULL,
    source_id INTEGER NOT NULL,
    title TEXT,
    author TEXT,
    poster_url TEXT,
    web_url TEXT,
    video_url TEXT NOT NULL,
    duration_sec REAL,
    position_ms INTEGER NOT NULL DEFAULT 0,
    watched_at INTEGER NOT NULL,
    PRIMARY KEY (video_id, source_id)
);

CREATE INDEX IF NOT EXISTS reels_watch_history_watched_at_index ON reels_watch_history(watched_at DESC);
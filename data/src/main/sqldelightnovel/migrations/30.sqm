-- Repairs dangling novel_series.category_id rows (novel parity of the manga migration 53).
-- The series category reference has no FK and DeleteNovelCategory historically never reset it,
-- so deleting a category left its series pointing at a nonexistent id: the series group is not
-- associated with any displayed category and its volumes are suppressed as series members,
-- making them invisible on every library page with no UI path to recover. Orphaned series move
-- to the default category (0). Going forward the interactor resets series on category deletion.
UPDATE novel_series
SET category_id = 0
WHERE category_id != 0
    AND category_id NOT IN (SELECT _id FROM novel_categories);
